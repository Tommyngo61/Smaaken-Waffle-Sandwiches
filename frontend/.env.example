# Copy to .env for local dev, or set as real env vars in your Cloud Run
# deploy. Both are Vite build-time vars (baked into the JS bundle at
# `npm run build` - not read at runtime by the server).
#
# Leave both unset to develop against the bundled src/content.json instead
# of a live Tablecloth instance - App.jsx falls back automatically for
# content, though the menu and ordering flow need a real Tablecloth to work.

# Your Tablecloth API's base URL (no trailing slash), e.g.:
# VITE_TABLECLOTH_API_URL=https://tablecloth-app-xxxxx-uw.a.run.app
VITE_TABLECLOTH_API_URL=

# This site's id in Tablecloth (Settings tab in the dashboard, or the URL
# when you have the site open).
VITE_SITE_ID=
